<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>WhatsApp Group Links 2026</title>
  <style>
    body {
      background-color: #0d0d0d;
      color: #ffffff;
      font-family: Arial, sans-serif;
      margin: 0;
      padding: 15px;
    }
    .main-title {
      text-align: center;
      font-size: 22px;
      margin-bottom: 20px;
    }
    .groupizo-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 12px;
    }
    @media (min-width: 768px) {
      .groupizo-grid { grid-template-columns: repeat(4, 1fr); }
    }
    .groupizo-card {
      background: #1a1a1a;
      border-radius: 12px;
      overflow: hidden;
      position: relative;
      border: 1px solid #2a2a2a;
      cursor: pointer;
    }
    .card-banner {
      width: 100%;
      height: 110px;
      position: relative;
    }
    .card-banner img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }
    .flag-badge {
      position: absolute;
      top: 8px;
      right: 8px;
      background: rgba(0,0,0,0.7);
      padding: 2px 6px;
      border-radius: 4px;
      font-size: 12px;
    }
    .card-info { padding: 10px; }
    .card-title {
      font-size: 13px;
      font-weight: bold;
      margin-bottom: 6px;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }
    .card-country {
      font-size: 11px;
      color: #888888;
      background: #262626;
      padding: 3px 8px;
      border-radius: 10px;
      display: inline-block;
    }
  </style>
</head>
<body>

  <h2 class="main-title">Active WhatsApp Group Links 2026</h2>

  <div class="groupizo-grid">
    <div class="groupizo-card ad-click-trigger" data-whatsapp="https://chat.whatsapp.com/CplDJwawNuO82pcPyFqJhk?s=cl&p=a&mlu=4&ilr=4">
      <div class="card-banner">
        <span class="flag-badge">🌐</span>
        <img src="https://images.unsplash.com/photo-1529156069898-49953e39b3ac?w=300" alt="Group Banner">
      </div>
      <div class="card-info">
        <div class="card-title">Join Active Chat Group</div>
        <span class="card-country">🌐 Public Group</span>
      </div>
    </div>
  </div>

  <script>
    var adsterraSmartLink = "https://www.profitableratecpmnetwork.com/f3efetw5?key=3ceb773fc9c7ca64b0cca412512cf6dc";

    document.querySelectorAll('.ad-click-trigger').forEach(function(card) {
      card.addEventListener('click', function() {
        var targetGroup = this.getAttribute('data-whatsapp');
        window.open(adsterraSmartLink, '_blank');
        window.location.href = targetGroup;
      });
    });
  </script>

</body>
</html>
